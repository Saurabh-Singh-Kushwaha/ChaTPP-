rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    // =========================
    // USERS
    // =========================

    match /users/{userId} {

      allow read: if request.auth != null;

      allow create, update: if
        request.auth != null &&
        request.auth.uid == userId;

      allow delete: if
        request.auth != null &&
        request.auth.uid == userId;
    }


    // =========================
    // UNIQUE HANDLES
    // =========================

    match /handles/{handle} {

      allow read: if request.auth != null;

      allow create: if
        request.auth != null &&
        request.resource.data.uid ==
        request.auth.uid;

      allow update, delete: if
        request.auth != null &&
        resource.data.uid ==
        request.auth.uid;
    }


    // =========================
    // PRIVACY LOCK
    // =========================

    match /privacyLocks/{userId} {

      allow read, create, update, delete:
        if request.auth != null &&
        request.auth.uid == userId;
    }


    // =========================
    // FRIEND REQUESTS
    // =========================

    match /friendRequests/{requestId} {

      allow read: if
        request.auth != null &&
        (
          resource.data.fromUid ==
            request.auth.uid ||
          resource.data.toUid ==
            request.auth.uid
        );


      allow create: if
        request.auth != null &&
        request.resource.data.fromUid ==
          request.auth.uid;


      allow update: if
        request.auth != null &&
        resource.data.toUid ==
          request.auth.uid;


      allow delete: if
        request.auth != null &&
        (
          resource.data.fromUid ==
            request.auth.uid ||
          resource.data.toUid ==
            request.auth.uid
        );
    }


    // =========================
    // FRIENDSHIPS
    // =========================

    match /friendships/{friendshipId} {

      allow read: if
        request.auth != null &&
        request.auth.uid in resource.data.users;


      allow create: if
        request.auth != null &&
        request.auth.uid in
          request.resource.data.users;


      allow delete: if
        request.auth != null &&
        request.auth.uid in resource.data.users;


      allow update: if false;
    }


    // =========================
    // EVERYTHING ELSE
    // =========================

    match /{document=**} {

      allow read, write: if false;

    }

  }
}
