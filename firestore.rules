rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {


    // ==============================
    // USERS
    // ==============================

    match /users/{userId} {

      // Logged-in users can view user profiles
      allow read: if request.auth != null;

      // User can create/update only their own profile
      allow create, update: if
        request.auth != null &&
        request.auth.uid == userId;

      // User can delete only their own profile
      allow delete: if
        request.auth != null &&
        request.auth.uid == userId;
    }


    // ==============================
    // PRIVACY LOCK
    // ==============================

    match /privacyLocks/{userId} {

      // Only the owner can read their privacy lock
      allow read: if
        request.auth != null &&
        request.auth.uid == userId;


      // Only the owner can create their privacy lock
      allow create: if
        request.auth != null &&
        request.auth.uid == userId;


      // Only the owner can update their privacy lock
      allow update: if
        request.auth != null &&
        request.auth.uid == userId;


      // Only the owner can delete their privacy lock
      allow delete: if
        request.auth != null &&
        request.auth.uid == userId;
    }


    // ==============================
    // DEFAULT DENY
    // ==============================

    match /{document=**} {
      allow read, write: if false;
    }

  }
}
